    "import time\n",
    "import scipy.sparse as sp\n",
    "from scipy.sparse.linalg import eigsh\n",
    "from sklearn.neighbors import kneighbors_graph\n",
    "\n",
    "\n",
    "def build_laplacian(X, k=10, sigma=1):\n",
    "    '''\n",
    "    Unnormalized graph Laplacian of the symmetric k-nearest-neighbour graph with Gaussian weights\n",
    "    (same as build_laplacian in handin.ipynb).\n",
    "    '''\n",
    "    S = kneighbors_graph(X, k, mode='distance', include_self=False)\n",
    "    S = S.maximum(S.T).tocsr()\n",
    "    W = S.copy()\n",
    "    W.data = np.exp(-W.data**2 / (2 * sigma**2))\n",
    "    D = sp.diags(np.asarray(W.sum(axis=1)).ravel())\n",
    "    return (D - W).tocsr()\n",
    "\n",
    "\n",
    "def converged_at(L, m, K, tol):\n",
    "    '''True if the K smallest Ritz pairs after m Lanczos steps all have residual |beta_m e_m^T y| < tol.'''\n",
    "    theta, U, res = lanczos_iteration(L, m, K=K, reorth=True)\n",
    "    return len(res) == K and np.all(res < tol)\n",
    "\n",
    "\n",
    "def lanczos_steps(L, K, tol=1e-10, M=1000):\n",
    "    '''\n",
    "    Smallest number of Lanczos steps m <= M after which the K smallest Ritz pairs have residual < tol.\n",
    "    Found by doubling m and then bisection (the residuals decrease with m, up to rounding).\n",
    "\n",
    "    Return:\n",
    "        m: The number of steps (M if not converged)\n",
    "        conv: True if converged within M steps\n",
    "    '''\n",
    "    lo, hi = 0, max(K, 8)\n",
    "    while not converged_at(L, hi, K, tol):\n",
    "        if hi >= M:\n",
    "            return M, False\n",
    "        lo, hi = hi, min(2 * hi, M)\n",
    "    while hi - lo > 1:\n",
    "        mid = (lo + hi) // 2\n",
    "        if converged_at(L, mid, K, tol):\n",
    "            hi = mid\n",
    "        else:\n",
    "            lo = mid\n",
    "    return hi, True\n",
    "\n",
    "\n",
    "def lanczos_experiment(L, n_pairs=4, tol=1e-10, M=1000):\n",
    "    '''\n",
    "    Number of Lanczos steps needed for the smallest Ritz pair and for the n_pairs smallest Ritz pairs,\n",
    "    the number predicted by rho_1, the cost per step, and a comparison with scipy.sparse.linalg.eigsh.\n",
    "\n",
    "    Parameters:\n",
    "        L: The graph Laplacian, scipy sparse matrix of shape (N,N)\n",
    "        n_pairs: The number of Ritz pairs (default 4)\n",
    "        tol: Tolerance on the residual |beta_m e_m^T y|\n",
    "        M: The maximum number of Lanczos steps\n",
    "\n",
    "    Return:\n",
    "        dict with size, sparsity, spectrum, step counts and timings\n",
    "    '''\n",
    "    N = L.shape[0]\n",
    "\n",
    "    # Reference (library): shift-invert eigsh for the smallest eigenvalues, eigsh for lambda_n\n",
    "    t0 = time.perf_counter()\n",
    "    ref = np.sort(eigsh(L, k=n_pairs + 6, sigma=-1e-3, which='LM', return_eigenvectors=False))\n",
    "    t_eigsh = time.perf_counter() - t0\n",
    "    lam_n = eigsh(L, k=1, which='LA', return_eigenvectors=False)[0]\n",
    "    tol0 = 1e-8 * lam_n                               # threshold for \"numerically equal\"\n",
    "    lambdas = np.append(ref, lam_n)                   # enough of the spectrum for lanczos_rate\n",
    "\n",
    "    # Prediction for the smallest pair: res_1 * (1/rho_1)^(m-1) = tol\n",
    "    r = lanczos_rate(lambdas, 0, tol0)\n",
    "    res_1 = lanczos_iteration(L, 1, K=1)[2][0]\n",
    "    pred = 1 + np.log(tol / res_1) / np.log(r)\n",
    "\n",
    "    # Own implementation: steps for the smallest pair and for n_pairs pairs\n",
    "    m_1, conv_1 = lanczos_steps(L, 1, tol, M)\n",
    "    m_K, conv_K = lanczos_steps(L, n_pairs, tol, M)\n",
    "\n",
    "    # Time for the converged run (n_pairs pairs, with reorthogonalization)\n",
    "    t0 = time.perf_counter()\n",
    "    lanczos_iteration(L, m_K, K=n_pairs, reorth=True)\n",
    "    t_lanczos = time.perf_counter() - t0\n",
    "\n",
    "    # Cost per step for a fixed number of steps, best of 5: plain Alg. 6.15 and with reorthogonalization\n",
    "    n_time = 100\n",
    "    t_plain = min(timeit(lambda: lanczos_iteration(L, n_time, K=1, reorth=False)) for _ in range(5)) / n_time\n",
    "    t_reorth = min(timeit(lambda: lanczos_iteration(L, n_time, K=1, reorth=True)) for _ in range(5)) / n_time\n",
    "\n",
    "    return dict(N=N, nnz=L.nnz, nnz_row=L.nnz / N,\n",
    "                m0=int(np.sum(ref < tol0)),                      # multiplicity of 0 = connected components\n",
    "                gap=lambdas[np.argmax(ref > tol0)], lam_n=lam_n, r=r,\n",
    "                pred=pred, m_1=m_1, m_K=m_K, conv=conv_1 and conv_K,\n",
    "                t_plain=t_plain, t_reorth=t_reorth, t_lanczos=t_lanczos, t_eigsh=t_eigsh)\n",
    "\n",
    "\n",
    "def timeit(f):\n",
    "    t0 = time.perf_counter()\n",
    "    f()\n",
    "    return time.perf_counter() - t0\n",
    "\n",
    "\n",
    "def print_table(rows, keys):\n",
    "    print(\"  \".join(f\"{key:>9}\" for key in keys))\n",
    "    for row in rows:\n",
    "        print(\"  \".join(f\"{row[key]:>9.3g}\" if isinstance(row[key], float) else f\"{row[key]!s:>9}\" for key in keys))\n",
    "\n",
    "\n",
    "keys = [\"N\", \"nnz\", \"nnz_row\", \"m0\", \"gap\", \"lam_n\", \"r\", \"pred\", \"m_1\", \"m_K\", \"conv\",\n",
    "        \"t_plain\", \"t_reorth\", \"t_lanczos\", \"t_eigsh\"]\n",
    "\n",
    "# Experiment 1: size. Fixed k = 10, sigma = 1, N = 4n grows\n",
    "size_rows = []\n",
    "for n in [50, 100, 200, 400, 800, 1600]:\n",
    "    np.random.seed(0)\n",
    "    size_rows.append(lanczos_experiment(build_laplacian(make_data(n=n), k=10)))\n",
    "print(\"Size (k = 10, sigma = 1, tol = 1e-10, M = 1000):\")\n",
    "print_table(size_rows, keys)\n",
    "\n",
    "# Experiment 2: sparsity. Fixed data set, N = 400, number of neighbours k grows\n",
    "np.random.seed(0)\n",
    "X_s = make_data(n=100)\n",
    "sparse_rows = []\n",
    "for k in [5, 10, 20, 40, 80, 160]:\n",
    "    sparse_rows.append(dict(k=k, **lanczos_experiment(build_laplacian(X_s, k=k))))\n",
    "print(\"\\nSparsity (N = 400, sigma = 1, tol = 1e-10, M = 1000):\")\n",
    "print_table(sparse_rows, [\"k\"] + keys)"
   ]
