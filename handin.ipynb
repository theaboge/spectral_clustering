    "def tracked_residual(h, d, i):\n",
    "    '''\n",
    "    Residual of the Ritz pair that approximates the i-th distinct eigenvalue d[i], for every m.\n",
    "\n",
    "    The pairs are labelled by the eigenvalue they approximate, not by their position in the sorted list:\n",
    "    among the Ritz values within half the distance to the neighbouring distinct eigenvalues, the smallest\n",
    "    residual is taken (NaN if there is no Ritz value in this window yet). A new copy of 0 moving down\n",
    "    through the spectrum then no longer changes the numbering of the other pairs.\n",
    "    '''\n",
    "    w = 0.5 * min(d[i + 1] - d[i], d[i] - d[i - 1] if i > 0 else np.inf)\n",
    "    out = []\n",
    "    for theta, res in zip(h[\"theta\"], h[\"res\"]):\n",
    "        near = np.abs(theta - d[i]) < w\n",
    "        out.append(res[near].min() if near.any() else np.nan)\n",
    "    return np.array(out)\n",
    "\n",
    "\n",
    "def residual_plot(h, lambdas, name, ax, n_pairs=3):\n",
    "    '''\n",
    "    Residual |beta_m e_m^T y| of the Ritz pairs approximating the n_pairs smallest distinct eigenvalues\n",
    "    against the number of Lanczos steps m, with the theoretical rate rho_1^{-m} for the smallest one.\n",
    "    '''\n",
    "    tol0 = 1e-10 * lambdas[-1]\n",
    "    d = distinct(lambdas, tol0)\n",
    "    for i in range(n_pairs):\n",
    "        res_i = tracked_residual(h, d, i)\n",
    "        ax.semilogy(h[\"ms\"], res_i, lw=2, alpha=0.8,\n",
    "                    label=fr\"$\\theta^{{(m)}} \\to \\lambda = {d[i]:.3g}$\" if d[i] > tol0\n",
    "                    else r\"$\\theta^{(m)} \\to \\lambda = 0$\")\n",
    "        print(f\"{name}, lambda = {d[i]:.3g}: residual < 1e-10 after m = {h['ms'][np.argmax(res_i < 1e-10)]}\")\n",
    "\n",
    "    # Theory for the smallest eigenvalue, anchored at m = 10, drawn down to the rounding level\n",
    "    r = lanczos_rate(lambdas, 0, tol0)\n",
    "    res1 = tracked_residual(h, d, 0)\n",
    "    k0 = 10\n",
    "    ms = h[\"ms\"][k0 - 1:]\n",
    "    theory = res1[k0 - 1] * r**(ms - k0)\n",
    "    floor = np.finfo(float).eps * lambdas[-1]       # rounding level of the residual estimate\n",
    "    keep = theory > floor\n",
    "    ax.semilogy(ms[keep], theory[keep], \"k--\", lw=1, label=fr\"theory $\\rho_1^{{-m}}$, $1/\\rho_1 = {r:.3f}$\")\n",
    "    ax.axhline(floor, color=\"grey\", lw=1, ls=\"-.\", label=r\"rounding level $\\varepsilon_{\\mathrm{mach}} \\lambda_n$\")\n",
    "\n",
    "    # Observed rate for lambda = 0: log-linear fit where the residual is between 1e-12 and 1e-1\n",
    "    fit = (h[\"ms\"] >= k0) & (res1 > 1e-12) & (res1 < 1e-1)\n",
    "    first_small = np.argmax(res1 < 1e-12)          # stop the fit at the first time the pair has converged\n",
    "    fit &= h[\"ms\"] < h[\"ms\"][first_small]\n",
    "    r_obs = np.exp(np.polyfit(h[\"ms\"][fit], np.log(res1[fit]), 1)[0])\n",
    "    print(f\"{name}: lambda = 0, 1/rho_1 theory = {r:.4f}, observed = {r_obs:.4f}\")\n",
    "\n",
    "    ax.set_xlabel(\"Lanczos steps $m$\", fontsize=11)\n",
    "    ax.set_title(name, fontsize=12)\n",
    "    ax.grid(alpha=0.3)\n",
    "    ax.legend(fontsize=9)\n",
    "\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(11, 4.2), sharey=True)\n",
    "residual_plot(hist_gaussian, lambdas_gaussian, \"Gaussian clusters\", axes[0])\n",
    "residual_plot(hist_moons, lambdas_moons, \"Moons\", axes[1])\n",
    "axes[0].set_ylabel(r\"residual $|\\beta_m\\, e_m^T y^{(m)}|$\", fontsize=11)\n",
    "axes[0].set_ylim(1e-17, 1e2)\n",
    "fig.tight_layout()\n",
    "plt.show()"
   ]
