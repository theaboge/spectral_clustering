   "source": [
    "import pandas as pd\n",
    "\n",
    "# Simple checks of QR iteration\n",
    "A_test_1 = np.array([\n",
    "    [2., 1., 0.],\n",
    "    [1., 2., 1.],\n",
    "    [0., 1., 2.]\n",
    "])\n",
    "\n",
    "A_test_2 = np.array([\n",
    "    [4., 1., 2., 3.],\n",
    "    [1., 5., 2., 1.],\n",
    "    [2., 2., 6., 2.],\n",
    "    [3., 1., 2., 7.]\n",
    "])\n",
    "\n",
    "for name, L_test in [(\"gaussian\", L), (\"moons\", L_moons)]:\n",
    "\n",
    "for test_name, A_test in [\n",
    "    (\"3x3 tridiagonal\", A_test_1),\n",
    "    (\"4x4 symmetric\", A_test_2)\n",
    "]:\n",
    "    histories = {}\n",
    "    deflation_history = None\n",
    "\n",
    "    for shifted, hessenberg in [\n",
    "        (False, False),\n",
    "        (True, False),\n",
    "        (False, True),\n",
    "        (True, True)\n",
    "    ]:\n",
    "        result, history, m_history = qr_experiment(\n",
    "            A_test,\n",
    "            tol=1e-10,\n",
    "            maxiter=500,\n",
    "            shifted=shifted,\n",
    "            hessenberg=hessenberg\n",
    "        )\n",
    "\n",
    "        result[\"test_matrix\"] = test_name\n",
    "        rows.append(result)\n",
    "        histories[result[\"method\"]] = history\n",
    "\n",
    "        # Save deflation history for the shifted Hessenberg variant\n",
    "        if shifted and hessenberg:\n",
    "            deflation_history = m_history\n",
    "\n",
    "    # Plot convergence and deflation progress\n",
    "    fig, axes = plt.subplots(1, 2, figsize=(13, 4))\n",
    "\n",
    "    # Convergence plot\n",
    "    for method, history in histories.items():\n",
    "        axes[0].semilogy(\n",
    "            np.arange(1, len(history) + 1),\n",
    "            history,\n",
    "            label=method\n",
    "        )\n",
    "\n",
    "    axes[0].set_xlabel(\"Iteration\")\n",
    "    axes[0].set_ylabel(\"Maximum absolute off-diagonal element\")\n",
    "    axes[0].set_title(f\"QR convergence: {test_name}\")\n",
    "    axes[0].grid(True, which=\"both\", alpha=0.3)\n",
    "    axes[0].legend()\n",
    "\n",
    "    # Deflation plot\n",
    "    axes[1].step(\n",
    "        np.arange(0, len(deflation_history) + 1),\n",
    "        np.r_[A_test.shape[0], deflation_history],\n",
    "        where=\"post\"\n",
    "    )\n",
    "\n",
    "    axes[1].set_xlabel(\"Iteration\")\n",
    "    axes[1].set_ylabel(\"Active block size (m)\")\n",
    "    axes[1].set_title(f\"Deflation progress: {test_name}\")\n",
    "    axes[1].set_ylim(0.5, A_test.shape[0] + 0.5)\n",
    "    axes[1].grid(True, alpha=0.3)\n",
    "\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "# Present numerical results\n",
    "df = pd.DataFrame(rows)\n",
    "\n",
    "# Show \"-\" for methods without deflation\n",
    "df[\"deflations\"] = df[\"deflations\"].astype(object)\n",
    "df.loc[~df[\"method\"].str.contains(\"deflation\"), \"deflations\"] = \"-\"\n",
    "\n",
    "display(\n",
    "    df.drop(columns=[\"active_size\"]).style.format({\n",
    "        \"tol\": \"{:.1e}\",\n",
    "        \"time\": \"{:.3f}\",\n",
    "        \"eig_error\": \"{:.3e}\",\n",
    "        \"residual\": \"{:.3e}\",\n",
    "        \"orth_error\": \"{:.3e}\",\n",
    "        \"sim_error\": \"{:.3e}\",\n",
    "        \"offdiag\": \"{:.3e}\",\n",
    "        \"lambda_min\": \"{:.6f}\"\n",
    "    })\n",
    ")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "0760ff05",
   "metadata": {},
   "source": [
    "The computed eigenvalues and eigenvectors closely agree with the Scipy reference solutions, with small residuals and orthogonality errors.\n",
    "\n",
    "Shifted QR with Householder reduction and deflation converged in 15 and 17 iterations for the two test matrices, compared with 45 and 53 iterations for standard unshifted QR. However, shifted QR without deflation stagnated on the $3\\times3$ matrix, illustrating a limitation of the simple shift strategy $\\mu_k = a_{mm}$.\n",
    "\n",
    "The deflation plots show how the active matrix dimension decreases as eigenvalues are isolated."
   ]
  },
