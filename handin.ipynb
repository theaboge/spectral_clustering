   "source": [
    "# Test QR iteration on graph Laplacians\n",
    "rows = []\n",
    "histories = {}\n",
    "m_histories = {}\n",
    "\n",
    "for name, L_test in [\n",
    "    (\"clusters\", L),\n",
    "    (\"moons\", L_moons)\n",
    "]:\n",
    "    result, history, m_history = qr_experiment(\n",
    "        L_test,\n",
    "        tol=1e-8,\n",
    "        maxiter=1500,\n",
    "        shifted=True,\n",
    "        hessenberg=True\n",
    "    )\n",
    "\n",
    "    result[\"dataset\"] = name\n",
    "    rows.append(result)\n",
    "\n",
    "    histories[name] = history\n",
    "    m_histories[name] = m_history\n",
    "\n",
    "# Display numerical results\n",
    "df = pd.DataFrame(rows)\n",
    "\n",
    "display(\n",
    "    df.style.format({\n",
    "        \"tol\": \"{:.1e}\",\n",
    "        \"time\": \"{:.3f}\",\n",
    "        \"eig_error\": \"{:.3e}\",\n",
    "        \"residual\": \"{:.3e}\",\n",
    "        \"orth_error\": \"{:.3e}\",\n",
    "        \"sim_error\": \"{:.3e}\",\n",
    "        \"offdiag\": \"{:.3e}\",\n",
    "        \"lambda_min\": \"{:.6f}\"\n",
    "    })\n",
    ")\n",
    "\n",
    "# Plot convergence and deflation progress separately for each dataset\n",
    "for name, L_test in [\n",
    "    (\"clusters\", L),\n",
    "    (\"moons\", L_moons)\n",
    "]:\n",
    "    history = histories[name]\n",
    "    m_history = m_histories[name]\n",
    "    n = L_test.shape[0]\n",
    "\n",
    "    fig, axes = plt.subplots(1, 2, figsize=(13, 4))\n",
    "\n",
    "    # Convergence history\n",
    "    axes[0].semilogy(\n",
    "        np.arange(1, len(history) + 1),\n",
    "        history\n",
    "    )\n",
    "    axes[0].set_xlabel(\"Iteration\")\n",
    "    axes[0].set_ylabel(\"Maximum absolute off-diagonal element\")\n",
    "    axes[0].set_title(f\"QR convergence: {name}\")\n",
    "    axes[0].grid(True, which=\"both\", alpha=0.3)\n",
    "\n",
    "    # Deflation history\n",
    "    axes[1].step(\n",
    "        np.arange(0, len(m_history) + 1),\n",
    "        np.r_[n, m_history],\n",
    "        where=\"post\"\n",
    "    )\n",
    "    axes[1].set_xlabel(\"Iteration\")\n",
    "    axes[1].set_ylabel(\"Active block size (m)\")\n",
    "    axes[1].set_title(f\"Deflation progress: {name}\")\n",
    "    axes[1].set_ylim(min(m_history) - 10, n + 5)\n",
    "    axes[1].grid(True, alpha=0.3)\n",
    "\n",
    "    plt.tight_layout()\n",
    "    plt.show()"
   ]
