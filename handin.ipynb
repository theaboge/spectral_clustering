   "source": [
    "The implemented Householder transformation preserves the eigenvalues and orthogonality to machine precision. The resulting matrices have the expected tridiagonal structure, including the case where the input matrix is already tridiagonal. This validates the reduction before applying QR iteration."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 112,
   "id": "e15b397b",
   "metadata": {},
   "outputs": [],
   "source": [
    "import time\n",
    "\n",
    "def qr_experiment(L, tol=1e-8, maxiter=1000, shifted=False, hessenberg=False):\n",
    "    \"\"\"\n",
    "    Test QR iteration against SciPy and return numerical results.\n",
    "\n",
    "    Parameters:\n",
    "        L: The input matrix (sparse or dense)\n",
    "        tol: Convergence tolerance\n",
    "        maxiter: Maximum number of iterations\n",
    "        shifted: Whether to use shifted QR iteration\n",
    "        hessenberg: Whether to use Hessenberg QR iteration (if also shifted=True => deflation)\n",
    "\n",
    "    Returns:\n",
    "        result: Dictionary with numerical results\n",
    "        history: Convergence history\n",
    "        m_history: Deflation history\n",
    "    \"\"\"\n",
    "    L_dense = L.toarray() if sp.issparse(L) else L.copy()\n",
    "    n = L_dense.shape[0]\n",
    "\n",
    "    # Reference eigenvalues\n",
    "    lambdas_ref = la.eigh(L_dense, eigvals_only=True)\n",
    "\n",
    "    # Own QR implementation\n",
    "    start = time.perf_counter()\n",
    "    A_k, V_qr, k, converged, history, m_history = qr_iteration(\n",
    "        L, tol=tol, maxiter=maxiter, shifted=shifted, hessenberg=hessenberg\n",
    "    )\n",
    "    elapsed = time.perf_counter() - start\n",
    "\n",
    "    # Sort computed eigenpairs\n",
    "    lambdas_qr = np.diag(A_k)\n",
    "    idx = np.argsort(lambdas_qr)\n",
    "    lambdas_qr = lambdas_qr[idx]\n",
    "    V_qr = V_qr[:, idx]\n",
    "\n",
    "    # Eigenvalue errors and eigenpair residuals\n",
    "    eigenvalue_error = np.max(np.abs(lambdas_qr - lambdas_ref))\n",
    "    residuals = la.norm(L_dense @ V_qr - V_qr * lambdas_qr, axis=0)\n",
    "\n",
    "    # Orthogonality and similarity errors\n",
    "    orthogonality_error = la.norm(V_qr.T @ V_qr - np.eye(n))\n",
    "    similarity_error = la.norm(V_qr.T @ L_dense @ V_qr - A_k[np.ix_(idx, idx)])\n",
    "\n",
    "    # Store results\n",
    "    result = dict(\n",
    "        method = (\n",
    "            \"shifted QR + Hessenberg + deflation\" if shifted and hessenberg\n",
    "            else \"shifted QR\" if shifted\n",
    "            else \"unshifted QR + Hessenberg\" if hessenberg\n",
    "            else \"unshifted QR\"\n",
    "        ),\n",
    "        N=f\"{n}x{n}\",\n",
    "        tol=tol,\n",
    "        maxiter=maxiter,\n",
    "        iterations=k,\n",
    "        converged=converged,\n",
    "        time=elapsed,\n",
    "        deflations=n - m_history[-1],\n",
    "        active_size=m_history[-1],\n",
    "        eig_error=eigenvalue_error,\n",
    "        residual=np.max(residuals),\n",
    "        orth_error=orthogonality_error,\n",
    "        sim_error=similarity_error,\n",
    "        offdiag=history[-1],\n",
    "        lambda_min=lambdas_qr[0]\n",
    "    )\n",
    "\n",
    "    return result, np.array(history), np.array(m_history)"
   ]
  },
