    "# Dependence of QR iteration on matrix size and graph sparsity\n",
    "\n",
    "rng = np.random.default_rng(0)\n",
    "permutation = rng.permutation(len(X))\n",
    "\n",
    "rows_scaling = []\n",
    "\n",
    "# Matrix size: varying N, fixed k = 10\n",
    "for N in [100, 200, 400]:\n",
    "    X_test = X[permutation[:N]]\n",
    "    L_test = build_laplacian(X_test, k=10, sigma=1)\n",
    "\n",
    "    result, history, m_history = qr_experiment(\n",
    "        L_test,\n",
    "        tol=1e-8,\n",
    "        maxiter=1500,\n",
    "        shifted=True,\n",
    "        hessenberg=True\n",
    "    )\n",
    "\n",
    "    rows_scaling.append({\n",
    "        \"experiment\": \"Matrix size\",\n",
    "        \"N\": N,\n",
    "        \"k\": 10,\n",
    "        \"density\": L_test.nnz / N**2,\n",
    "        \"iterations\": result[\"iterations\"],\n",
    "        \"converged\": result[\"converged\"],\n",
    "        \"time\": result[\"time\"],\n",
    "        \"deflations\": result[\"deflations\"],\n",
    "        \"residual\": result[\"residual\"]\n",
    "    })\n",
    "\n",
    "# Sparsity: fixed N = 200, varying k\n",
    "N = 200\n",
    "X_test = X[permutation[:N]]\n",
    "\n",
    "for k_neighbours in [5, 10, 20]:\n",
    "    L_test = build_laplacian(\n",
    "        X_test, k=k_neighbours, sigma=1\n",
    "    )\n",
    "\n",
    "    result, history, m_history = qr_experiment(\n",
    "        L_test,\n",
    "        tol=1e-8,\n",
    "        maxiter=1500,\n",
    "        shifted=True,\n",
    "        hessenberg=True\n",
    "    )\n",
    "\n",
    "    rows_scaling.append({\n",
    "        \"experiment\": \"Sparsity\",\n",
    "        \"N\": N,\n",
    "        \"k\": k_neighbours,\n",
    "        \"density\": L_test.nnz / N**2,\n",
