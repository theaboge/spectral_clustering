    "# Simple check of Householder transformation to Hessenberg-form\n",
    "\n",
    "# Already tridiagonal\n",
    "A_test_1 = A_test = np.array([\n",
    "    [2., 1., 0.],\n",
    "    [1., 2., 1.],\n",
    "    [0., 1., 2.]\n",
    "])\n",
    "\n",
    "# Simple 4x4-matrix\n",
    "A_test_2 = np.array([\n",
    "    [4., 1., 2., 3.],\n",
    "    [1., 5., 2., 1.],\n",
    "    [2., 2., 6., 2.],\n",
    "    [3., 1., 2., 7.]\n",
    "])\n",
    "\n",
    "for number, A_test in [(\"1\", A_test_1), (\"2\", A_test_2)]:\n",
    "    H, P = householder(A_test)\n",
    "\n",
    "    # Check orthogonality\n",
    "    orth_error = la.norm(P.T @ P - np.eye(A_test.shape[0]))\n",
    "\n",
    "    # Check similarity transformation\n",
    "    sim_error = la.norm(P.T @ A_test @ P - H)\n",
    "\n",
    "    # Check Hessenberg structure\n",
    "    hess_error = la.norm(np.tril(H, -2))\n",
    "\n",
    "    # Check eigenvalues\n",
    "    eig_error = np.max(\n",
    "        np.abs(la.eigh(A_test, eigvals_only=True)\n",
    "            - la.eigh(H, eigvals_only=True))\n",
    "    )\n",
    "\n",
    "    print(\"-\" * 40)\n",
    "    print(\"Householder reduction\", number)\n",
    "    print(\"-\" * 40)\n",
    "    print(f\"Orthogonality error: {orth_error:.3e}\")\n",
    "    print(f\"Similarity error:   {sim_error:.3e}\")\n",
    "    print(f\"Hessenberg error:   {hess_error:.3e}\")\n",
    "    print(f\"Eigenvalue error:   {eig_error:.3e}\")\n",
    "\n",
    "    print(\"\\nHessenberg matrix\", number)\n",
    "    print(H)"
   ]
